#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-top20-qm9
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
VENDOR=/lustre/home/users/sm2/chou/molgap-pcqm-route-b/vendor-cu126-torch271
SHIMS=/lustre/home/users/sm2/chou/molgap-pcqm-route-b/code/platforms/ims/pcqm_route_b/shims
GRAPH_ROOT=$ROOT/pcqm_tgt_lite_graphs
OUT=$ROOT/outputs/pcqm_tgt_lite_seed${SEED:-42}
cd "$ROOT"
test -f "$GRAPH_ROOT/manifest.json"
export PYTHONPATH="$SHIMS:$VENDOR:$ROOT/code/src"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
mkdir -p "$OUT"

nvidia-smi -L
"$PYTHON" -u -c "from pathlib import Path; from molgap.pcqm_tgt_lite import train_tgt_lite, PCQMTGTLiteConfig; c=PCQMTGTLiteConfig(seed=int('${SEED:-42}')); train_tgt_lite(root=Path('${GRAPH_ROOT}'), output_dir=Path('${OUT}'), config=c)" 2>&1 | tee "$ROOT/logs/pcqm_tgt_lite_seed${SEED:-42}.log"
