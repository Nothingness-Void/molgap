#!/bin/bash
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
MANIFEST="$ROOT/fusion_inputs/repaired_2m_manifest.parquet"
PRIMARY="$ROOT/primary/graph_shards"
PRIMARY_ACCEPTANCE="$ROOT/primary/primary_acceptance.json"
CACHE="$ROOT/pair_gps_2d"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test -f "$MANIFEST"
test -f "$PRIMARY_ACCEPTANCE"
mkdir -p "$CACHE" logs
export PYTHONPATH="$ROOT/deps/site:$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

"$PYTHON" -u "$ROOT/code/experiments/pubchemqc_pair_gps_2d/build_cache.py" \
  --manifest "$MANIFEST" \
  --primary-graph-dir "$PRIMARY" \
  --primary-acceptance "$PRIMARY_ACCEPTANCE" \
  --output-dir "$CACHE" \
  --workers 14 2>&1 | tee "$ROOT/logs/build_pair_gps_2d_cache.log"
