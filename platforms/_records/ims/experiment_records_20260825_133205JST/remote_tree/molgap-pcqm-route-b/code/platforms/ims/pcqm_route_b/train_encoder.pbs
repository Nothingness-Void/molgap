#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

: "${ENCODER_NAME:?submit with jsub -q H -v ENCODER_NAME=<name>}"
case "$ENCODER_NAME" in
  gps9|gps11_160|primary_schnet|augmented_schnet) ;;
  *) echo "unsupported ENCODER_NAME=$ENCODER_NAME" >&2; exit 2 ;;
esac

ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
cd "$ROOT"

test "$(realpath "$ROOT")" = "$ROOT"
test -f "outputs/preflight/${ENCODER_NAME}.json"
mkdir -p "outputs/$ENCODER_NAME" logs

export PYTHONPATH="$ROOT/code/platforms/ims/pcqm_route_b/shims:$ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
"$PYTHON" code/platforms/ims/pcqm_route_b/train_encoder.py \
  --root "$ROOT" \
  --encoder "$ENCODER_NAME" 2>&1 | tee "logs/${ENCODER_NAME}.log"
