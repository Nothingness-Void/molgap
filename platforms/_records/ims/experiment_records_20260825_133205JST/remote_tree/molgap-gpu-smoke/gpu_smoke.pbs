#!/bin/bash
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:ngpus=1
#PBS -l walltime=00:05:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-gpu-smoke
mkdir -p "$ROOT"
cd "$ROOT"

echo "host=$(hostname)"
echo "job=${PBS_JOBID:-unknown}"
echo "cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L
nvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap \
  --format=csv,noheader
