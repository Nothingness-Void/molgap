#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:30:00
#PBS -j oe
set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-geometry-scratch-control
OLD=/lustre/home/users/sm2/chou/molgap-pcqm-geometry-warmstart
CODE=$ROOT/scratch-code
case "${ARM:?ARM is required}" in triangle|geometry) ;; *) exit 2 ;; esac
test "$(realpath "$ROOT")" = "$ROOT"
test "$(realpath "$CODE")" = "$CODE"
cd "$ROOT"
export PYTHONPATH=/lustre/home/users/sm2/chou/molgap-pcqm-route-b/code/platforms/ims/pcqm_route_b/shims:/lustre/home/users/sm2/chou/molgap-pcqm-route-b/vendor-cu126-torch271:$CODE/src
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1
/lustre/home/users/sm2/chou/molgap/.venv/bin/python -u "$CODE/experiments/pcqm_geometry_scratch_control/scratch.py" train \
  --graph-dir "$OLD/graph_cache" --acceptance "$OLD/artifacts/geometry_acceptance.json" \
  --preflight "$ROOT/preflight.json" --arm "$ARM" --output "$ROOT/training_$ARM" \
  2>&1 | tee -a "$ROOT/train_$ARM.log"
