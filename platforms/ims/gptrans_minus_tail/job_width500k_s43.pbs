#!/bin/bash
#PBS -N GPTW500S43
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=1:ngpus=1
#PBS -l walltime=10:00:00
#PBS -j oe
# GPT-T 500K capacity question, card s43: R, L20, W320, F3 in this order (experiments/pcqm_gptrans_width_500k_20261117/protocol.md): jsub -q H job_width500k_s43.pbs
# Cut by walltime? Resubmit the SAME command from this root: finished tasks are skipped, a paused task resumes from its last_checkpoint.pt.
# Override walltime with  jsub -q H -l walltime=HH:MM:SS -v WALL_S=<seconds> job_width500k_s43.pbs  (keep WALL_S equal to it).
# The driver sets the model-shape variables per task. Output goes to logs/train.log (no pipe, so SIGTERM cannot break the driver's stdout).
set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-gptrans-width-500k-s43-20261117
RB=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
OGB_ZIP=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip  # pure-python ogb 1.3.6 (AtomEncoder/BondEncoder); same archive the K1/GPT-T full jobs use
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
WALL_S=${WALL_S:-36000}

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test "$(realpath "$RB/vendor-cu126-torch271")" = "$RB/vendor-cu126-torch271"
test -x "$PYTHON"
test -f "$OGB_ZIP"
mkdir -p "$ROOT/logs" "$ROOT/runs"

export PYTHONPATH="$RB/code/platforms/ims/pcqm_route_b/shims:$RB/vendor-cu126-torch271:$OGB_ZIP:$ROOT/code/src:$ROOT/code"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=42

echo "[job] ${PBS_JOBID:-nojob} start $(date -u +%FT%TZ) WALL_S=$WALL_S" >> "$ROOT/logs/train.log"
"$PYTHON" -u "$ROOT/code/platforms/ims/gptrans_minus_tail/run_width_500k_serial.py" --card s43 --root "$ROOT" --wall-s "$WALL_S" >> "$ROOT/logs/train.log" 2>&1
