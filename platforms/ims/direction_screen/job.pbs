#!/bin/bash
#PBS -N DS100KJob
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=2:ngpus=1
#PBS -l walltime=06:30:00
#PBS -j oe
# Packed job: jsub -q H -v JOB=H1 job.pbs   (JOB in H1|H2|B1). Override walltime at submit time per jobs.json
# (H1 default needs 07:00:00). Resubmitting the same JOB resumes unfinished arms from ckpt_last.pt.
set -euo pipefail

: "${JOB:?submit with jsub -q H -v JOB=<H1|H2|B1>}"
case "$JOB" in H1|H2|B1) ;; *) echo "unsupported JOB=$JOB" >&2; exit 2 ;; esac

ROOT=/lustre/home/users/sm2/chou/molgap-direction-screen-20261114
RB=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
OGB_ZIP=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip
EXPORT=/lustre/home/users/sm2/chou/pcqm4mv2-kaggle1-exports-v3/ogb-train-100k
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
EXP="$ROOT/code/experiments/pcqm_direction_screen_100k_20261114"
WALL_S=${WALL_S:-23400}      # PBS walltime in seconds (default 06:30); set -v WALL_S=25200 for 07:00
SLOTS=${SLOTS:-4}

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test "$(realpath "$EXPORT")" = "$EXPORT"
test "$(realpath "$RB/vendor-cu126-torch271")" = "$RB/vendor-cu126-torch271"
test -x "$PYTHON"
test -f "$ROOT/inputs/features_v1.npz"
test -f "$ROOT/smoke/smoke.json"
"$PYTHON" -c "import json,sys; sys.exit(0 if json.load(open('$ROOT/smoke/smoke.json'))['ok'] else 3)"
mkdir -p "$ROOT/logs" "$ROOT/runs"

export PYTHONPATH="$RB/code/platforms/ims/pcqm_route_b/shims:$RB/vendor-cu126-torch271:$OGB_ZIP:$ROOT/code/src:$ROOT/code"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONUNBUFFERED=1

# stop children 10 min before walltime so they checkpoint at a step boundary
"$PYTHON" -u "$EXP/run_job.py" --job "$JOB" --slots "$SLOTS" --deadline-s $((WALL_S - 600)) \
  --root "$ROOT" --export-root "$EXPORT" --features "$ROOT/inputs/features_v1.npz" 2>&1 | tee -a "$ROOT/logs/job_${JOB}.log"
