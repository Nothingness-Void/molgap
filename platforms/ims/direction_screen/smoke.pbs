#!/bin/bash
#PBS -N DS100KSmoke
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=2:ngpus=1
#PBS -l walltime=00:40:00
#PBS -j oe
# S0 smoke: submit with  jsub -q H smoke.pbs   (cwd-independent)
set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-direction-screen-20261114
RB=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
OGB_ZIP=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip
EXPORT=/lustre/home/users/sm2/chou/pcqm4mv2-kaggle1-exports-v3/ogb-train-100k
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
EXP="$ROOT/code/experiments/pcqm_direction_screen_100k_20261114"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test "$(realpath "$EXPORT")" = "$EXPORT"
test "$(realpath "$RB/vendor-cu126-torch271")" = "$RB/vendor-cu126-torch271"
test -x "$PYTHON"
test -f "$OGB_ZIP"
test -f "$ROOT/inputs/features_v1.npz"
test -f "$EXP/row_identity_local.json"
mkdir -p "$ROOT/logs" "$ROOT/smoke"

export PYTHONPATH="$RB/code/platforms/ims/pcqm_route_b/shims:$RB/vendor-cu126-torch271:$OGB_ZIP:$ROOT/code/src:$ROOT/code"
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONUNBUFFERED=1

"$PYTHON" -u "$EXP/smoke.py" \
  --export-root "$EXPORT" \
  --features "$ROOT/inputs/features_v1.npz" \
  --work "$ROOT/smoke" \
  --identity "$EXP/row_identity_local.json" 2>&1 | tee "$ROOT/logs/smoke.log"
