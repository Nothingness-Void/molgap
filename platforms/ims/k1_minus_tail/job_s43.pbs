#!/bin/bash
#PBS -N K1MT43
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=1:ngpus=1
#PBS -l walltime=09:00:00
#PBS -j oe
# K1 minus-tail B1024 (Muon, 60 passes, rows [0,3.25M), seed 43 init): jsub -q H job.pbs
# Cut by walltime? Resubmit the SAME command: the runner resumes from runs/.../last_checkpoint.pt.
# Override walltime with  jsub -q H -l walltime=HH:MM:SS -v WALL_S=<seconds> job.pbs  (keep WALL_S equal to it).
set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-k1-minus-tail-b1024-s43-20261115
RB=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
OGB_ZIP=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip  # pure-python ogb 1.3.6 (AtomEncoder/BondEncoder); kept as on the GPT-T job; K1 itself does not import ogb (check recorded in the submission record)
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
WALL_S=${WALL_S:-32400}

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test "$(realpath "$RB/vendor-cu126-torch271")" = "$RB/vendor-cu126-torch271"
test -x "$PYTHON"
test -f "$OGB_ZIP"
mkdir -p "$ROOT/logs" "$ROOT/runs"

export PYTHONPATH="$RB/code/platforms/ims/pcqm_route_b/shims:$RB/vendor-cu126-torch271:$OGB_ZIP:$ROOT/code/src:$ROOT/code"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=42

echo "[job] ${PBS_JOBID:-nojob} start $(date -u +%FT%TZ) WALL_S=$WALL_S"
"$PYTHON" -u "$ROOT/code/platforms/ims/k1_minus_tail/run_k1_s43.py" --root "$ROOT" --wall-s "$WALL_S" 2>&1 | tee -a "$ROOT/logs/train.log"
