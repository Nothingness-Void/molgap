#!/bin/bash
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
BOUNDARY=/lustre/home/users/sm2/chou
STAGE="${MOLGAP_V2_STAGE:?explicit immutable source/rule staging required}"
OUTPUT="${MOLGAP_V2_OUTPUT:?explicit separate versioned output required}"
IDENTITY_ONLY="${MOLGAP_IDENTITY_ONLY:-1}"
test "$(realpath "$BOUNDARY")" = "$BOUNDARY"
test "$(realpath "$STAGE")" = "$STAGE"
test "$(realpath -m "$OUTPUT")" = "$OUTPUT"
case "$STAGE" in "$BOUNDARY"/*) ;; *) exit 2 ;; esac
case "$OUTPUT" in "$BOUNDARY"/*) ;; *) exit 2 ;; esac
case "$OUTPUT" in "$BOUNDARY/pcqm4mv2-fixed-v1"*) exit 2 ;; esac
case "$IDENTITY_ONLY" in 1) EXTRA=(--identity-only) ;; 0) EXTRA=() ;; *) exit 2 ;; esac
if test "${MOLGAP_VERIFY_EXCEPTIONS:-0}" = 1; then
  IDENTITY_ROOT="${MOLGAP_IDENTITY_ROOT:?explicit identity audit root required}"
  test "$(realpath "$IDENTITY_ROOT")" = "$IDENTITY_ROOT"
  case "$IDENTITY_ROOT" in "$BOUNDARY"/*) ;; *) exit 2 ;; esac
  EXTRA=(--verify-exceptions --identity-root "$IDENTITY_ROOT" --identity-audit-sha256 "${MOLGAP_IDENTITY_AUDIT_SHA:?explicit audit SHA required}")
fi
export PYTHONPATH="$STAGE/code/src"
if test "$IDENTITY_ONLY" = 0 || test "${MOLGAP_VERIFY_EXCEPTIONS:-0}" = 1; then
  # Reuse the owning runtime registry, not an installation or training launcher.
  PYTHONPATH="$("$BOUNDARY/molgap/.venv/bin/python" - "$STAGE" "$BOUNDARY" <<'PY'
import json, os, sys
from pathlib import Path
stage, boundary = map(Path, sys.argv[1:])
registry = stage/'code/platforms/ims/v4_submit/runtime_registry.json'
runtime = json.loads(registry.read_text())['runtimes']['ims-a100-torch271-v1']
# The registered venv entrypoint is intentional; following its interpreter
# symlink probes system paths outside the user boundary and is unnecessary.
assert Path(runtime['python']) == boundary/'molgap/.venv/bin/python'
paths = [p.format(code_root=str(stage/'code')) for p in runtime['pythonpath']]
assert all(Path(p).resolve().is_relative_to(boundary) for p in paths)
print(os.pathsep.join(paths))
PY
)"
  export PYTHONPATH
fi
export PYTHONNOUSERSITE=1
export CUDA_VISIBLE_DEVICES=-1 HIP_VISIBLE_DEVICES=-1 ROCR_VISIBLE_DEVICES=-1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
FALLBACK_LEDGER="${MOLGAP_FALLBACK_LEDGER:-$STAGE/code/experiments/pcqm_k1_scale500k/parser_fallback_audit_v4.json}"
test "$(realpath "$FALLBACK_LEDGER")" = "$FALLBACK_LEDGER"
case "$FALLBACK_LEDGER" in "$BOUNDARY"/*) ;; *) exit 2 ;; esac
umask 077
cd "$STAGE"
printf 'CPU_ONLY job=%s identity_only=%s source_stage=%s\n' "${PBS_JOBID:-UNKNOWN}" "$IDENTITY_ONLY" "$STAGE"
"$BOUNDARY/molgap/.venv/bin/python" "$STAGE/code/platforms/ims/pcqm_fixed_datasets/prepare_unified_roles.py" \
  --boundary "$BOUNDARY" --fixed-root "$BOUNDARY/pcqm4mv2-fixed-v1" \
  --output-root "$OUTPUT" --rule "$STAGE/rule.json" --workers 3 \
  --role-inventory "$STAGE/role_inventory.json" \
  --fallback-ledger "$FALLBACK_LEDGER" \
  "${EXTRA[@]}"
