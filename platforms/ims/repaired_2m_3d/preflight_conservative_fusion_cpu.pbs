#!/bin/bash
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
CODE_ROOT="$ROOT/architecture_repair_r1"
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
INPUTS="$ROOT/fusion_inputs"
OUTPUT="$ROOT/preflight/conservative_hierarchical_fusion_r1.json"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
export PYTHONPATH="$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$CODE_ROOT/src"

"$PYTHON" "$CODE_ROOT/experiments/resource_bounded_architecture/preflight_conservative_fusion.py" \
  --frozen-2d "$INPUTS/frozen_2d_test_payload.pt" \
  --manifest "$INPUTS/repaired_2m_scaffold_groups.npz" \
  --primary-embeddings "$ROOT/embeddings/primary" \
  --augmented-embeddings "$ROOT/embeddings/augmented" \
  --output "$OUTPUT"
