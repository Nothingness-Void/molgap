#!/bin/bash
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=1
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
SCREEN="$ROOT/pubchemqc100k_pairgps"
SPLIT="$SCREEN/split.csv"
CACHE="$SCREEN/cache_18d"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test -f "$SPLIT"
mkdir -p "$CACHE" "$ROOT/logs"
export PYTHONPATH="$ROOT/deps/site:$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

"$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/build_pair_gps_2d_cache.py" \
  --split-csv "$SPLIT" \
  --output-dir "$CACHE" \
  --workers 14 --shard-rows 5000 2>&1 \
  | tee -a "$ROOT/logs/build_pair_gps_2d_100k_cache.log"

"$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/accept_pair_gps_2d_cache.py" \
  --split-csv "$SPLIT" \
  --cache-dir "$CACHE" 2>&1 \
  | tee -a "$ROOT/logs/accept_pair_gps_2d_100k_cache.log"
