#!/bin/bash
#PBS -N PC100KPairBench
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=1:ngpus=1
#PBS -l walltime=00:45:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
SCREEN="$ROOT/pubchemqc100k_pairgps"
SPLIT="$SCREEN/split.csv"
CACHE="$SCREEN/cache_18d"
OUTPUT_DIR="$SCREEN/benchmarks/a100_throughput_v1"
OUTPUT="$OUTPUT_DIR/benchmark.json"
GPU_LOG="$OUTPUT_DIR/nvidia_smi.csv"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test -f "$SPLIT"
test -f "$CACHE/acceptance.json"
mkdir -p "$OUTPUT_DIR" "$ROOT/logs"
export PYTHONPATH="$ROOT/deps/site:$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

nvidia-smi --query-gpu=timestamp,utilization.gpu,utilization.memory,memory.used,power.draw,clocks.sm \
  --format=csv -l 1 > "$GPU_LOG" &
MONITOR_PID=$!
cleanup_monitor() {
  kill "$MONITOR_PID" 2>/dev/null || true
  wait "$MONITOR_PID" 2>/dev/null || true
}
trap cleanup_monitor EXIT

"$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/benchmark_pair_gps_2d_a100.py" \
  --split-csv "$SPLIT" \
  --cache-dir "$CACHE" \
  --output "$OUTPUT" \
  --learning-rate 2e-4 --seed 42 \
  --config fp32:64:0 \
  --config fp32:64:4 \
  --config fp32:128:4 \
  --config fp32:256:4 \
  --config tf32:128:4 \
  --config tf32:256:4 \
  --config bf16:128:4 \
  --config bf16:256:4 \
  --config bf16:384:4 \
  --config bf16:512:4 2>&1 \
  | tee "$ROOT/logs/benchmark_pair_gps_2d_a100.log"
