#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
CACHE="$ROOT/pair_gps_2d"
OUTPUT="$ROOT/outputs/pair_gps_2d_v2_seed42"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test -f "$CACHE/acceptance.json"
test -f "$ROOT/preflight/pair_gps_2d_v2.json"
mkdir -p "$OUTPUT" "$ROOT/logs"
export PYTHONPATH="$ROOT/deps/site:$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

"$PYTHON" -u "$ROOT/code/experiments/pubchemqc_pair_gps_2d/train.py" \
  --cache-dir "$CACHE" \
  --output-dir "$OUTPUT" \
  --epochs 20 --patience 6 \
  --batch-size "${BATCH_SIZE:-32}" \
  --eval-batch-size "${EVAL_BATCH_SIZE:-32}" \
  --checkpoint-every-shards 10 \
  --learning-rate 4e-4 --weight-decay 1e-5 \
  --seed 42 --split-seed 42 --resume 2>&1 \
  | tee "$ROOT/logs/train_pair_gps_2d_v2_seed42.log"
