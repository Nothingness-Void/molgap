#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/lustre/home/users/sm2/chou/molgap-repaired-2m-3d
ROUTE_B_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
SCREEN="$ROOT/pubchemqc100k_pairgps"
SPLIT="$SCREEN/split.csv"
CACHE="$SCREEN/cache_18d"
OUTPUT="$SCREEN/search"

cd "$ROOT"
test "$(realpath "$ROOT")" = "$ROOT"
test -f "$SPLIT"
test -f "$CACHE/acceptance.json"
mkdir -p "$OUTPUT" "$ROOT/logs"
export PYTHONPATH="$ROOT/deps/site:$ROUTE_B_ROOT/code/platforms/ims/pcqm_route_b/shims:$ROUTE_B_ROOT/vendor:$ROOT/code/src"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

for trial in lr1e4 lr2e4 lr4e4; do
  case "$trial" in
    lr1e4) learning_rate=1e-4 ;;
    lr2e4) learning_rate=2e-4 ;;
    lr4e4) learning_rate=4e-4 ;;
  esac
  for candidate in gps7 gps9; do
    "$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/train_pair_gps_2d_screen.py" \
      --split-csv "$SPLIT" \
      --cache-dir "$CACHE" \
      --output-dir "$OUTPUT/${candidate}_${trial}_seed42" \
      --candidate "$candidate" \
      --epochs 40 --patience 10 --batch-size 64 \
      --learning-rate "$learning_rate" --weight-decay 1e-5 \
      --seed 42 --resume 2>&1 \
      | tee -a "$ROOT/logs/train_pair_gps_2d_100k_search.log"
  done
  "$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/evaluate_gps7_gps9_equal_validation.py" \
    --split-csv "$SPLIT" \
    --cache-dir "$CACHE" \
    --gps7-dir "$OUTPUT/gps7_${trial}_seed42" \
    --gps9-dir "$OUTPUT/gps9_${trial}_seed42" \
    --output-dir "$OUTPUT/gps7_gps9_equal_${trial}_seed42" 2>&1 \
    | tee -a "$ROOT/logs/train_pair_gps_2d_100k_search.log"
done

for trial in lr1e4 lr2e4 lr4e4; do
  case "$trial" in
    lr1e4) learning_rate=1e-4 ;;
    lr2e4) learning_rate=2e-4 ;;
    lr4e4) learning_rate=4e-4 ;;
  esac
  "$PYTHON" -u "$ROOT/code/experiments/pubchemqc100k_architecture/train_pair_gps_2d_screen.py" \
    --split-csv "$SPLIT" \
    --cache-dir "$CACHE" \
    --output-dir "$OUTPUT/pair_gps_2d_${trial}_seed42" \
    --candidate pair_gps_2d \
    --epochs 40 --patience 10 --batch-size 64 \
    --learning-rate "$learning_rate" --weight-decay 1e-5 \
    --seed 42 --resume 2>&1 \
    | tee -a "$ROOT/logs/train_pair_gps_2d_100k_search.log"
done
