#!/bin/bash
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
test "$(realpath "$ROOT")" = "$ROOT"
cd "$ROOT"
mkdir -p feature_screen/results feature_screen/logs
export PYTHONPATH="$ROOT/code/src:$ROOT/vendor"
"$PYTHON" code/experiments/pcqm_edge_state_full/feature_screen.py accept-runs \
  --runs-dir feature_screen/runs \
  --output feature_screen/results/acceptance.json \
  2>&1 | tee feature_screen/logs/accept_runs.log
