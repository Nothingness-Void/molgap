#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
test "$(realpath "$ROOT")" = "$ROOT"
cd "$ROOT"
mkdir -p outputs/training logs
export PYTHONPATH="$ROOT/code/src:$ROOT/vendor"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
"$PYTHON" code/experiments/pcqm_edge_state_full/run.py train \
  --graph-dir inputs/graphs \
  --acceptance inputs/graphs/acceptance.json \
  --output-dir outputs/training \
  --max-epochs 10 --patience 3 --batch-size 256 --eval-batch-size 512 \
  2>&1 | tee logs/train.log
