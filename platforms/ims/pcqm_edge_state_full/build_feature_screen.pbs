#!/bin/bash
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
SHARD_INDEX="${SHARD_INDEX:-${PBS_ARRAY_INDEX:-}}"
test -n "$SHARD_INDEX"
test "$(realpath "$ROOT")" = "$ROOT"
cd "$ROOT"
mkdir -p feature_screen/graphs/reports feature_screen/logs
export PYTHONPATH="$ROOT/code/src:$ROOT/vendor"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
"$PYTHON" code/experiments/pcqm_edge_state_full/feature_screen.py build \
  --rows-dir feature_screen/rows \
  --graph-dir feature_screen/graphs \
  --shard-index "$SHARD_INDEX" \
  2>&1 | tee "feature_screen/logs/build_${SHARD_INDEX}.log"
