#!/bin/bash
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=14:00:00
#PBS -j oe

set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
test "$(realpath "$ROOT")" = "$ROOT"
cd "$ROOT"
test -s rich_full/graphs/acceptance.json
test -s rich_full/training/last.pt
test -s rich_full/training/best.pt
test -s rich_full/training/completion_manifest.json
mkdir -p rich_full/convergence_40/logs
export PYTHONPATH="$ROOT/rich_full/convergence_40/code/src:$ROOT/code/src:$ROOT/vendor"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4

"$PYTHON" rich_full/convergence_40/code/experiments/pcqm_edge_state_full/run.py continue-training \
  --graph-dir rich_full/graphs \
  --acceptance rich_full/graphs/acceptance.json \
  --source-dir rich_full/training \
  --output-dir rich_full/convergence_40 \
  --additional-epochs 20 \
  --learning-rate 1.0e-4 \
  --minimum-learning-rate 1.0e-6 \
  --scheduler warmup_cosine \
  --warmup-epochs 2 \
  --patience 7 \
  --batch-size 256 \
  --eval-batch-size 512 \
  --gradient-clip 1.0 \
  --hard-job-budget-hours 13.5 \
  2>&1 | tee rich_full/convergence_40/logs/continuation.log
