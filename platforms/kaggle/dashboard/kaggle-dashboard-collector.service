[Unit]
Description=Collect Kaggle quota and configured kernel states

[Service]
Type=oneshot
User=kaggle-dashboard
Group=kaggle-dashboard
WorkingDirectory=/opt/molgap
EnvironmentFile=/etc/kaggle-dashboard/options
ExecStart=/opt/molgap/.venv/bin/python platforms/kaggle/dashboard.py collect /var/lib/kaggle-dashboard/status.json --full-snapshot $OPTIONS
TimeoutStartSec=100
StateDirectory=kaggle-dashboard
UMask=0027
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
