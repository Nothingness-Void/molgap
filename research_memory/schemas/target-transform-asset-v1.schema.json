{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molgap-target-transform-asset-v1",
  "type": "object",
  "required": ["format", "asset_id", "mean", "std", "ddof", "variance_convention", "source_row_manifest_sha256", "target_identity", "target_sha256", "asset_sha256"],
  "properties": {
    "format": {"const": "molgap-target-transform-asset-v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "mean": {"type": "number"},
    "std": {"type": "number", "exclusiveMinimum": 0},
    "ddof": {"type": "integer", "minimum": 0},
    "variance_convention": {"type": "string", "minLength": 1},
    "source_row_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_identity": {"type": "string", "minLength": 1},
    "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical sorted compact JSON for this record with asset_sha256 omitted."
    }
  },
  "additionalProperties": false
}
