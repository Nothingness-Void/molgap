{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molgap-ready-for-desktop-v1",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "trajectory_id",
    "candidate_evidence_id",
    "qualification_100k_evidence_ids",
    "qualification_500k_evidence_ids",
    "funnel_requires_500k",
    "source_commit",
    "candidate_contract_identity",
    "reference_contract_identity",
    "source_config_identity",
    "contract_refs",
    "reference_ids",
    "comparison_refs",
    "role_history_refs",
    "native_cost_event_ids",
    "cost_summary_ref",
    "artifact_refs",
    "artifact_hashes",
    "transfer_status",
    "known_limitations",
    "desktop_question"
  ],
  "properties": {
    "schema": {"const": "molgap-ready-for-desktop-v1"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "trajectory_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "candidate_evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "qualification_100k_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "qualification_500k_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "funnel_requires_500k": {"type": "boolean"},
    "source_commit": {"type": "string", "minLength": 1},
    "candidate_contract_identity": {"type": "string", "minLength": 1},
    "reference_contract_identity": {"type": "string", "minLength": 1},
    "source_config_identity": {"type": "string", "minLength": 1},
    "contract_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reference_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "comparison_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "role_history_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "native_cost_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "cost_summary_ref": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    },
    "transfer_status": {"const": "qualified"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "desktop_question": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
