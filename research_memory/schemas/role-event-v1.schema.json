    "trajectory_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "dataset_identity": {"type": "string", "minLength": 1},
    "row_manifest_hash": {"type": "string", "minLength": 1},
    "role_name": {"type": "string", "minLength": 1},
    "access_kind": {"enum": ["training_membership", "prediction_input", "labels_read", "metric_computed", "selection_used", "external_submission"]},
    "selection_used": {"type": "boolean"},
    "evidence_ref": {"type": "string", "minLength": 1}
