# Virtual environment
.venv/
.scnet/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/

# IDE / OS / tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
catboost_info/

# ── Binary and bulk artifacts ────────────────────────────────────────────────
# Rule of thumb: a decision record and its compact metrics are tracked; the raw
# payload that backs them is regenerable or retrievable, and stays local.

# Model weights and caches
models/**/*.pt
models/**/*.joblib
data/cache/*
!data/cache/README.md

# Large inputs: downloaded or produced by the pipeline
data/commercial/*.data
data/processed/*.csv
data/raw/*.csv
data/raw/**/*.csv
data/raw/*.json
data/raw/*.zip
data/raw/pcqm4m-v2/
data/raw/phase3_*.csv
data/raw/archive-r02-router-candidates/
data/raw/phase8_repair_v2_checkpoint_dataset/
!data/commercial/commercial_molecules_template.csv

# Keep empty directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/commercial/.gitkeep
!models/.gitkeep

# Gaussian temp files
*.chk
*.gjf.ap
*.sh.e*
*.sh.o*
fort.7
H-*.sh

# ── Evidence trees: production/, experiments/, platforms/ ────────────────────
# Same rule for all three, so moving a directory between them changes nothing.

# Tensors, arrays, databases
production/**/*.pt
experiments/**/*.pt
platforms/**/*.pt
production/**/*.npz
experiments/**/*.npz
platforms/**/*.npz
production/**/*.npy
experiments/**/*.npy
platforms/**/*.npy
production/**/*.db
experiments/**/*.db
platforms/**/*.db
production/**/*.sqlite
experiments/**/*.sqlite
platforms/**/*.sqlite

# Row-level tables, logs, and archives
production/**/*.csv
experiments/**/*.csv
platforms/**/*.csv
production/**/*.parquet
experiments/**/*.parquet
platforms/**/*.parquet
production/**/*.pkl
experiments/**/*.pkl
platforms/**/*.pkl
production/**/*.log
experiments/**/*.log
platforms/**/*.log
production/**/*.out
experiments/**/*.out
platforms/**/*.out
production/**/*.err
experiments/**/*.err
platforms/**/*.err
production/**/*.zip
experiments/**/*.zip
platforms/**/*.zip
production/**/*.tar.gz
experiments/**/*.tar.gz
platforms/**/*.tar.gz
production/**/*.joblib
experiments/**/*.joblib
platforms/**/*.joblib
production/**/*.ipynb
experiments/**/*.ipynb

# Row-level selection payloads: regenerable; the decision beside them is tracked.
experiments/**/selection.json

# Runtime snapshots uploaded to a remote platform are copies, not sources.
platforms/**/runtime_source/
platforms/**/model_assets/
platforms/**/_molgap_runtime/
platforms/**/kernel_sources/

# Vendored dependency payloads for offline clusters: retrievable from PyPI, and
# their SHA256SUMS manifest is what actually pins the environment.
platforms/**/wheels/*.whl
platforms/**/wheels/*.tar.gz

# Canonical executable code lives in src/molgap/ or a stage's scripts/ folder.
# Evidence directories must not become a second copy of it.
production/**/results/**/*.py
experiments/**/results/**/*.py
platforms/_records/**/*.py
platforms/_records/**/*.slurm
platforms/_records/**/*.sh

# Local-only remote outputs
platforms/scnet/records/**/*.txt

# Split upload payloads and row ledgers: transport artifacts, not evidence.
experiments/**/upload_parts/
experiments/**/ledger/

# Transferred dependency wheels and per-shard row payloads: retrievable from the
# upstream index or regenerable from the source CSV. Their SHA256SUMS manifest is
# what the acceptance record actually needs, and that stays tracked.
platforms/_records/**/wheels/*.whl
platforms/_records/**/inputs/**
