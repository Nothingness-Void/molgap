#!/bin/bash
#PBS -q H
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail
BOUNDARY=/lustre/home/users/sm2/chou
RUN_ROOT="$BOUNDARY/molgap-k1-tf32-paired-v1"
PYTHON="$BOUNDARY/molgap/.venv/bin/python"
SOURCE="$RUN_ROOT/source"
OUTPUT="$RUN_ROOT/output"
VENDOR="$BOUNDARY/molgap-pcqm-route-b"
OGB_ARCHIVE="$BOUNDARY/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip"
MOLGAP_TF32_CACHE_ROOT="$BOUNDARY/pcqm4mv2-kaggle1-exports-v3/ogb-train-100k"

test "$(realpath "$BOUNDARY")" = "$BOUNDARY"
test "$(realpath "$RUN_ROOT")" = "$RUN_ROOT"
test "$(realpath "$SOURCE")" = "$SOURCE"
test "$(realpath "$MOLGAP_TF32_CACHE_ROOT")" = "$MOLGAP_TF32_CACHE_ROOT"
case "$MOLGAP_TF32_CACHE_ROOT" in "$BOUNDARY"/*) ;; *) exit 91 ;; esac
test -f "$MOLGAP_TF32_CACHE_ROOT/manifest.json"
test -x "$PYTHON"
test -d "$VENDOR/code/platforms/ims/pcqm_route_b/shims"
test -d "$VENDOR/vendor-cu126-torch271"
test -f "$OGB_ARCHIVE"
test -f "$SOURCE/source.tar.gz"
test -f "$SOURCE/SOURCE_COMMIT.txt"
test -f "$SOURCE/SOURCE_ARCHIVE_SHA256.txt"
mkdir -p "$OUTPUT" "$RUN_ROOT/logs"

export PYTHONPATH="$VENDOR/code/platforms/ims/pcqm_route_b/shims:$VENDOR/vendor-cu126-torch271:$OGB_ARCHIVE:$SOURCE/src"
export MOLGAP_OGB_SOURCE_SHA256=a18d4cacc6a35ad24938f52cfe197a255a5f64bb197f8d0f056c204467ec1e33
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTHONHASHSEED=42
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 PYTHONUNBUFFERED=1
nvidia-smi -L
RESUME_ARGS=()
if [[ "${MOLGAP_TF32_RESUME:-0}" == 1 ]]; then RESUME_ARGS+=(--resume); fi
"$PYTHON" "$SOURCE/experiments/pcqm_k1_tf32_runtime_comparison_100k/run.py" \
  --cache-root "$MOLGAP_TF32_CACHE_ROOT" \
  --output-root "$OUTPUT" \
  --source-commit "$(cat "$SOURCE/SOURCE_COMMIT.txt")" \
  --source-archive "$SOURCE/source.tar.gz" \
  --source-archive-sha256 "$(cat "$SOURCE/SOURCE_ARCHIVE_SHA256.txt")" \
  "${RESUME_ARGS[@]}" \
  2>&1 | tee -a "$RUN_ROOT/logs/train.log"
