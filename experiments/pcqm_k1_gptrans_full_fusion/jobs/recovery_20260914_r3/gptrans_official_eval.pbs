#!/bin/bash
#PBS -N molgap-gpt-official-eval
#PBS -q H
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=8
#PBS -l walltime=04:00:00
#PBS -o /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/recovery_20260914_r3/logs/gptrans_official_eval.out
#PBS -e /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/recovery_20260914_r3/logs/gptrans_official_eval.err
set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/recovery_20260914_r3
VENDOR=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
export PYTHONPATH="$VENDOR/code/platforms/ims/pcqm_route_b/shims:$VENDOR/vendor-cu126-torch271:$ROOT/../inputs/ogb-1.3.6.zip:$ROOT/code/src"
export MOLGAP_OGB_SOURCE_SHA256=a18d4cacc6a35ad24938f52cfe197a255a5f64bb197f8d0f056c204467ec1e33
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export PYTHONUNBUFFERED=1
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
cd "$ROOT"
ARGS=(--model-root "$ROOT/outputs/gptrans/full" --graph-root /lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full/rich_full/graphs --output "$ROOT/outputs/gptrans_official_eval")
"$PYTHON" -m molgap.pcqm_gptrans_official_eval "${ARGS[@]}"
"$PYTHON" -m molgap.pcqm_gptrans_official_eval "${ARGS[@]}" --accept-only

