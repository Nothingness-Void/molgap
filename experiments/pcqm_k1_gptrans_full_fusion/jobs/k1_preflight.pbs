#!/bin/bash
#PBS -N molgap-k1-full-preflight
#PBS -q H
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=01:00:00
#PBS -o /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/logs/k1_preflight.out
#PBS -e /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/logs/k1_preflight.err
set -euo pipefail

RUN_ROOT=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full
DATA_ROOT=/lustre/home/users/sm2/chou/pcqm4mv2-fixed-v1
VENDOR_ROOT=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
CODE_ROOT="$RUN_ROOT/code"
export PYTHONPATH="$VENDOR_ROOT/code/platforms/ims/pcqm_route_b/shims:$VENDOR_ROOT/vendor-cu126-torch271:$RUN_ROOT/inputs/ogb-1.3.6.zip:$CODE_ROOT/src"
export MOLGAP_OGB_SOURCE_SHA256=a18d4cacc6a35ad24938f52cfe197a255a5f64bb197f8d0f056c204467ec1e33
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export PYTHONUNBUFFERED=1

GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader)
if [[ $(printf '%s\n' "$GPU_NAME" | wc -l) -ne 1 || "$GPU_NAME" != *A100* ]]; then
  echo "Expected exactly one A100, got: $GPU_NAME" >&2
  exit 2
fi
"$PYTHON" "$CODE_ROOT/experiments/pcqm_k1_full/run.py" preflight \
  --dataset-root "$DATA_ROOT" \
  --manifest "$DATA_ROOT/subsets/ogb-train-full/manifest.json" \
  --output "$RUN_ROOT/outputs/k1/preflight" \
  --platform-id ims-a100
