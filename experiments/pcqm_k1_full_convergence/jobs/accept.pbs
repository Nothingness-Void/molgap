#!/bin/bash
#PBS -N k1-conv-acc
#PBS -q H
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=2
#PBS -l walltime=00:20:00
#PBS -o /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/k1_convergence_20260915_r1/logs/accept.out
#PBS -e /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/k1_convergence_20260915_r1/logs/accept.err
set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/k1_convergence_20260915_r1
VENDOR=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
OGB_ARCHIVE=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/inputs/ogb-1.3.6.zip
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
export PYTHONPATH="$VENDOR/code/platforms/ims/pcqm_route_b/shims:$VENDOR/vendor-cu126-torch271:$OGB_ARCHIVE:$ROOT/code/src"
export MOLGAP_OGB_SOURCE_SHA256=a18d4cacc6a35ad24938f52cfe197a255a5f64bb197f8d0f056c204467ec1e33
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
cd "$ROOT"
"$PYTHON" "$ROOT/code/experiments/pcqm_k1_full_convergence/run.py" accept --output "$ROOT/output"
