#!/bin/bash
#PBS -N gpt-conv-pre
#PBS -q H
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=00:20:00
#PBS -o /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/gptrans_convergence_20260914_r1/logs/preflight.out
#PBS -e /lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/gptrans_convergence_20260914_r1/logs/preflight.err
set -euo pipefail
ROOT=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/gptrans_convergence_20260914_r1
BASE=/lustre/home/users/sm2/chou/molgap-k1-gpttrans-full/recovery_20260914_r3
DATA=/lustre/home/users/sm2/chou/pcqm4mv2-fixed-v1
VALID=/lustre/home/users/sm2/chou/molgap-pcqm-edge-state-full/rich_full/graphs
VENDOR=/lustre/home/users/sm2/chou/molgap-pcqm-route-b
PYTHON=/lustre/home/users/sm2/chou/molgap/.venv/bin/python
export PYTHONPATH="$VENDOR/code/platforms/ims/pcqm_route_b/shims:$VENDOR/vendor-cu126-torch271:$ROOT/code/src"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONUNBUFFERED=1
cd "$ROOT"
"$PYTHON" "$ROOT/code/experiments/pcqm_gptrans_full_convergence/run.py" preflight \
  --dataset-root "$DATA" --manifest "$DATA/subsets/ogb-train-full/manifest.json" \
  --valid-graph-root "$VALID" --source-root "$BASE/outputs/gptrans/full" \
  --source-evaluation "$BASE/outputs/gptrans_official_eval/acceptance.json" \
  --output "$ROOT/preflight"
